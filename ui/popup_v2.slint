import { Theme } from "components_v2.slint";

export component NotificationPopup inherits Window {
    title: "ntfy notification";
    icon: @image-url("assets/icon.svg");
    width: 380px;
    in-out property <float> popup-height-px: 112;
    height: root.popup-height-px * 1px;
    no-frame: true;
    always-on-top: true;
    background: #080d14;

    in-out property <string> popup-title: "ntfy";
    in-out property <string> popup-body: "";
    in-out property <string> popup-meta: "";
    callback dismiss();

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #0d1621;
        border-width: 1px;
        border-color: #31455d;
        border-radius: 12px;
        clip: true;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 3px;
            background: Theme.accent;
        }

        Rectangle {
            x: 15px;
            y: 14px;
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: Theme.accent-soft;
            border-width: 1px;
            border-color: #27684f;

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: "n";
                color: Theme.accent;
                font-size: 17px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 58px;
            y: 12px;
            width: parent.width - 104px;
            height: 23px;
            text: root.popup-title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 720;
            overflow: elide;
            vertical-alignment: center;
        }

        Text {
            x: 58px;
            y: 35px;
            width: parent.width - 104px;
            height: 13px;
            text: "NTFY // DESKTOP";
            color: Theme.muted;
            font-size: 8px;
            font-weight: 650;
            overflow: elide;
            vertical-alignment: center;
        }

        Rectangle {
            x: parent.width - 35px;
            y: 11px;
            width: 24px;
            height: 24px;
            border-radius: 7px;
            background: close-touch.has-hover ? Theme.hover : #00000000;
            border-width: close-touch.has-hover ? 1px : 0px;
            border-color: Theme.border;

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: "×";
                color: Theme.secondary;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            close-touch := TouchArea {
                clicked => { root.dismiss(); }
            }
        }

        Text {
            x: 58px;
            y: 54px;
            width: parent.width - 76px;
            height: parent.height - 84px;
            text: root.popup-body;
            color: Theme.secondary;
            font-size: 11px;
            wrap: word-wrap;
            overflow: elide;
        }

        Rectangle {
            x: 58px;
            y: parent.height - 27px;
            width: parent.width - 76px;
            height: 1px;
            background: Theme.border;
        }

        Text {
            x: 58px;
            y: parent.height - 23px;
            width: parent.width - 76px;
            height: 15px;
            text: root.popup-meta;
            color: Theme.muted;
            font-size: 8px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}
