import {
    CheckBox,
    ComboBox,
    HorizontalBox,
    VerticalBox,
} from "std-widgets.slint";
import {
    CompactButton,
    FieldLabel,
    PageHint,
    PageTitle,
    Theme,
} from "components_v2.slint";

export component NotificationSettingsPage inherits Rectangle {
    in-out property <bool> notifications-enabled;
    in-out property <bool> sound-enabled;
    in-out property <int> placement-index;
    in-out property <int> audio-output-index;
    in-out property <int> additional-audio-output-index;
    in property <[string]> audio-outputs;
    in property <[string]> additional-audio-outputs;
    callback save-settings();
    callback refresh-audio-outputs();

    background: #00000000;

    PageTitle {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: "Notifications";
    }

    PageHint {
        x: 0px;
        y: 29px;
        width: parent.width;
        text: "Choose one output, or add a second device to play both at the same time.";
    }

    Rectangle {
        x: 0px;
        y: 54px;
        width: parent.width;
        height: parent.height - 54px;
        border-radius: 12px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 3px;
            height: parent.height;
            background: Theme.violet;
        }

        VerticalBox {
            x: 16px;
            y: 12px;
            width: parent.width - 32px;
            height: parent.height - 24px;
            spacing: 4px;

            HorizontalBox {
                height: 38px;
                spacing: 8px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    background: #0c151f;
                    border-width: 1px;
                    border-color: root.notifications-enabled ? #285b4b : Theme.border;

                    CheckBox {
                        x: 10px;
                        y: 4px;
                        width: parent.width - 20px;
                        height: 30px;
                        text: "Show desktop popup";
                        checked <=> root.notifications-enabled;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    background: #0c151f;
                    border-width: 1px;
                    border-color: root.sound-enabled ? #31526b : Theme.border;

                    CheckBox {
                        x: 10px;
                        y: 4px;
                        width: parent.width - 20px;
                        height: 30px;
                        text: "Play sound";
                        checked <=> root.sound-enabled;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            FieldLabel {
                height: 14px;
                text: "PRIMARY AUDIO OUTPUT";
            }
            HorizontalBox {
                height: 32px;
                spacing: 7px;

                ComboBox {
                    horizontal-stretch: 1;
                    model: root.audio-outputs;
                    current-index <=> root.audio-output-index;
                    enabled: root.sound-enabled;
                }

                CompactButton {
                    width: 78px;
                    height: 32px;
                    label: "Refresh";
                    enabled: root.sound-enabled;
                    clicked => { root.refresh-audio-outputs(); }
                }
            }

            FieldLabel {
                height: 14px;
                text: "ADDITIONAL OUTPUT (OPTIONAL)";
            }
            ComboBox {
                height: 32px;
                model: root.additional-audio-outputs;
                current-index <=> root.additional-audio-output-index;
                enabled: root.sound-enabled;
            }

            FieldLabel {
                height: 14px;
                text: "SCREEN POSITION";
            }
            ComboBox {
                height: 32px;
                model: [
                    "Top left", "Top centre", "Top right",
                    "Middle left", "Centre", "Middle right",
                    "Bottom left", "Bottom centre", "Bottom right"
                ];
                current-index <=> root.placement-index;
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalBox {
                height: 30px;
                Rectangle { horizontal-stretch: 1; }
                CompactButton {
                    width: 104px;
                    height: 30px;
                    primary: true;
                    label: "Save settings";
                    clicked => { root.save-settings(); }
                }
            }
        }
    }
}
