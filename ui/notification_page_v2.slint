import {
    CheckBox,
    ComboBox,
    HorizontalBox,
    VerticalBox,
} from "std-widgets.slint";
import {
    CompactButton,
    FieldLabel,
    PageHint,
    PageTitle,
    Theme,
} from "components_v2.slint";

export component NotificationSettingsPage inherits Rectangle {
    in-out property <bool> notifications-enabled;
    in-out property <bool> sound-enabled;
    in-out property <int> placement-index;
    in-out property <int> audio-output-index;
    in property <[string]> audio-outputs;
    callback save-settings();
    callback refresh-audio-outputs();

    background: #00000000;

    PageTitle {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: "Notifications";
    }

    PageHint {
        x: 0px;
        y: 29px;
        width: parent.width;
        text: "Adaptive desktop cards, selectable audio, and safe nine-point screen placement.";
    }

    Rectangle {
        x: 0px;
        y: 54px;
        width: parent.width;
        height: parent.height - 54px;
        border-radius: 12px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 3px;
            height: parent.height;
            background: Theme.violet;
        }

        VerticalBox {
            x: 18px;
            y: 14px;
            width: parent.width - 36px;
            height: parent.height - 28px;
            spacing: 6px;

            HorizontalBox {
                height: 44px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 9px;
                    background: #0c151f;
                    border-width: 1px;
                    border-color: root.notifications-enabled ? #285b4b : Theme.border;

                    CheckBox {
                        x: 12px;
                        y: 7px;
                        width: parent.width - 24px;
                        height: 30px;
                        text: "Show desktop popup";
                        checked <=> root.notifications-enabled;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 9px;
                    background: #0c151f;
                    border-width: 1px;
                    border-color: root.sound-enabled ? #31526b : Theme.border;

                    CheckBox {
                        x: 12px;
                        y: 7px;
                        width: parent.width - 24px;
                        height: 30px;
                        text: "Play notification sound";
                        checked <=> root.sound-enabled;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            FieldLabel { text: "AUDIO OUTPUT"; }
            HorizontalBox {
                height: 34px;
                spacing: 8px;

                ComboBox {
                    horizontal-stretch: 1;
                    model: root.audio-outputs;
                    current-index <=> root.audio-output-index;
                    enabled: root.sound-enabled;
                }

                CompactButton {
                    width: 82px;
                    label: "Refresh";
                    enabled: root.sound-enabled;
                    clicked => { root.refresh-audio-outputs(); }
                }
            }

            FieldLabel { text: "SCREEN POSITION"; }
            ComboBox {
                height: 34px;
                model: [
                    "Top left", "Top centre", "Top right",
                    "Middle left", "Centre", "Middle right",
                    "Bottom left", "Bottom centre", "Bottom right"
                ];
                current-index <=> root.placement-index;
            }

            Rectangle {
                height: 52px;
                border-radius: 9px;
                background: #0c151f;
                border-width: 1px;
                border-color: Theme.border;

                Text {
                    x: 12px;
                    y: 7px;
                    width: parent.width - 24px;
                    height: 18px;
                    text: "Adaptive notification surface";
                    color: Theme.text;
                    font-size: 11px;
                    font-weight: 680;
                    vertical-alignment: center;
                }

                Text {
                    x: 12px;
                    y: 25px;
                    width: parent.width - 24px;
                    height: 18px;
                    text: "Short messages stay compact; longer bodies expand only as much as needed.";
                    color: Theme.muted;
                    font-size: 9px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalBox {
                height: 32px;
                Rectangle { horizontal-stretch: 1; }
                CompactButton {
                    width: 108px;
                    primary: true;
                    label: "Save settings";
                    clicked => { root.save-settings(); }
                }
            }
        }
    }
}
