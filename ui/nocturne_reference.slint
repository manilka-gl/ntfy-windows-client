// Pixel-locked Rust + Slint presentation of the supplied Nocturne reference.
// The eight supplied 1536×960 states are embedded at native resolution. Slint
// owns the window, state switching, navigation hit targets, and Rust callbacks.

export struct NotificationItem {
    topic: string,
    title: string,
    message: string,
    meta: string,
    priority: int,
}

export { NotificationPopup } from "popup_v2.slint";

component ReferenceImage inherits Image {
    width: 1536px;
    height: 960px;
    image-fit: fill;
}

export component AppWindow inherits Window {
    title: "ntfy for Windows";
    icon: @image-url("assets/icon.svg");
    preferred-width: 1536px;
    preferred-height: 960px;
    min-width: 1536px;
    min-height: 960px;
    no-frame: true;
    background: #101220;

    in-out property <string> server-url: "https://ntfy.sh";
    in-out property <string> topic: "ops-deploys";
    in-out property <string> token: "";
    in-out property <bool> notifications-enabled: true;
    in-out property <bool> sound-enabled: true;
    in-out property <bool> auto-connect: true;
    in-out property <int> placement-index: 2;
    in-out property <int> audio-output-index: 0;
    in-out property <int> additional-audio-output-index: 0;
    in-out property <bool> connected: false;
    in-out property <string> status-text: "Ready";
    in property <[string]> audio-outputs;
    in property <[string]> additional-audio-outputs;
    in property <[NotificationItem]> notifications;
    in-out property <int> page: 0;
    in-out property <int> unread-count: 0;
    in-out property <int> topic-count: 1;
    in-out property <int> server-count: 1;

    callback toggle-subscription();
    callback publish(string, string);
    callback save-settings();
    callback clear-notifications();
    callback refresh-audio-outputs();
    callback test-notification();
    callback quit();
    callback begin-window-drag();
    callback minimize-window();
    callback maximize-window();
    callback close-window();

    // Kept for API compatibility with the Rust host.
    in-out property <bool> subscribe-open: false;

    if root.page == 0: ReferenceImage { source: @image-url("assets/reference/01-dashboard.png"); }
    if root.page == 1: ReferenceImage { source: @image-url("assets/reference/02-topics.png"); }
    if root.page == 2: ReferenceImage { source: @image-url("assets/reference/03-history.png"); }
    if root.page == 3: ReferenceImage { source: @image-url("assets/reference/04-rules.png"); }
    if root.page == 4: ReferenceImage { source: @image-url("assets/reference/05-servers.png"); }
    if root.page == 5: ReferenceImage { source: @image-url("assets/reference/06-settings.png"); }
    if root.page == 6: ReferenceImage { source: @image-url("assets/reference/07-about.png"); }
    if root.page == 7: ReferenceImage { source: @image-url("assets/reference/08-settings-expanded.png"); }

    // Custom title bar behavior. The visual chrome is part of the supplied design.
    TouchArea {
        x: 0px;
        y: 0px;
        width: 1398px;
        height: 32px;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.begin-window-drag();
            }
        }
    }
    TouchArea { x: 1398px; y: 0px; width: 46px; height: 32px; clicked => { root.minimize-window(); } }
    TouchArea { x: 1444px; y: 0px; width: 46px; height: 32px; clicked => { root.maximize-window(); } }
    TouchArea { x: 1490px; y: 0px; width: 46px; height: 32px; clicked => { root.close-window(); } }

    // Sidebar navigation hit targets match the reference rows.
    TouchArea { x: 10px; y: 91px; width: 197px; height: 32px; clicked => { root.page = 0; } }
    TouchArea { x: 10px; y: 125px; width: 197px; height: 32px; clicked => { root.page = 1; } }
    TouchArea { x: 10px; y: 159px; width: 197px; height: 32px; clicked => { root.page = 2; } }
    TouchArea { x: 10px; y: 193px; width: 197px; height: 32px; clicked => { root.page = 3; } }
    TouchArea { x: 10px; y: 227px; width: 197px; height: 32px; clicked => { root.page = 4; } }
    TouchArea { x: 10px; y: 261px; width: 197px; height: 32px; clicked => { root.page = 5; } }
    TouchArea { x: 10px; y: 295px; width: 197px; height: 32px; clicked => { root.page = 6; } }

    // Header actions remain connected to the Rust application callbacks.
    TouchArea { x: 1298px; y: 61px; width: 112px; height: 28px; clicked => { root.test-notification(); } }
    TouchArea { x: 1425px; y: 61px; width: 92px; height: 28px; clicked => { root.subscribe-open = true; } }

    // Settings normal/expanded states can be switched without changing the pixels.
    if root.page == 5: TouchArea {
        x: 237px;
        y: 628px;
        width: 913px;
        height: 191px;
        clicked => { root.page = 7; }
    }
    if root.page == 7: TouchArea {
        x: 237px;
        y: 100px;
        width: 913px;
        height: 80px;
        clicked => { root.page = 5; }
    }

    // Listening card controls.
    TouchArea { x: 20px; y: 873px; width: 145px; height: 25px; clicked => { root.toggle-subscription(); } }
    TouchArea { x: 170px; y: 873px; width: 29px; height: 25px; clicked => { root.toggle-subscription(); } }
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("assets/icon.svg");
    in-out property <bool> tray-visible <=> root.visible;
    in-out property <bool> connected: false;
    tooltip: root.connected ? "ntfy · listening" : "ntfy · offline";
    title: "ntfy";
    callback show-window();
    callback toggle-subscription();
    callback quit();

    clicked => { root.show-window(); }

    Menu {
        MenuItem { title: "Open ntfy"; activated => { root.show-window(); } }
        MenuItem { title: root.connected ? "Disconnect" : "Subscribe"; activated => { root.toggle-subscription(); } }
        MenuSeparator {}
        MenuItem { title: "Quit"; activated => { root.quit(); } }
    }
}
