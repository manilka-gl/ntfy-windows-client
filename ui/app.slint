import { Button, CheckBox, ComboBox, LineEdit, TextEdit, VerticalBox, HorizontalBox, ListView } from "std-widgets.slint";

export struct NotificationItem {
    topic: string,
    title: string,
    message: string,
    time: string,
    priority: int,
}

export component AppWindow inherits Window {
    title: "ntfy for Windows";
    icon: @image-url("assets/icon.png");
    preferred-width: 760px;
    preferred-height: 660px;
    min-width: 560px;
    min-height: 460px;

    in-out property <string> server-url: "https://ntfy.sh";
    in-out property <string> topic;
    in-out property <string> token;
    in-out property <bool> notifications-enabled: true;
    in-out property <bool> sound-enabled: true;
    in-out property <int> notification-position-index: 8;
    in-out property <bool> connected: false;
    in-out property <string> status-text: "Disconnected";
    in property <[NotificationItem]> notifications;

    callback toggle-subscription;
    callback publish(string, string);
    callback save-settings;
    callback quit;

    VerticalBox {
        padding: 14px;
        spacing: 10px;

        Text { text: "ntfy Windows client"; font-size: 24px; font-weight: 700; }
        Text {
            text: "Native WinHTTP · bounded memory · one reusable notification popup";
            color: #666;
        }

        HorizontalBox {
            spacing: 8px;
            Text { text: "Server"; width: 72px; vertical-alignment: center; }
            LineEdit { text <=> root.server-url; placeholder-text: "https://ntfy.sh"; }
        }
        HorizontalBox {
            spacing: 8px;
            Text { text: "Topic"; width: 72px; vertical-alignment: center; }
            LineEdit { text <=> root.topic; placeholder-text: "alerts"; }
        }
        HorizontalBox {
            spacing: 8px;
            Text { text: "Token"; width: 72px; vertical-alignment: center; }
            LineEdit { text <=> root.token; input-type: password; placeholder-text: "optional access token"; }
        }
        HorizontalBox {
            spacing: 8px;
            CheckBox { text: "Show custom notifications"; checked <=> root.notifications-enabled; }
            CheckBox { text: "Play sound"; checked <=> root.sound-enabled; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Save"; clicked => { root.save-settings(); } }
            Button {
                text: root.connected ? "Disconnect" : "Subscribe";
                clicked => { root.toggle-subscription(); }
            }
        }
        HorizontalBox {
            spacing: 8px;
            Text { text: "Notification position"; vertical-alignment: center; }
            ComboBox {
                horizontal-stretch: 1;
                model: [
                    "Top left", "Top center", "Top right",
                    "Middle left", "Center", "Middle right",
                    "Bottom left", "Bottom center", "Bottom right"
                ];
                current-index <=> root.notification-position-index;
            }
        }

        Rectangle { height: 1px; background: #d8d8d8; }

        Text { text: "Publish"; font-size: 18px; font-weight: 600; }
        publish-title := LineEdit { placeholder-text: "Title (optional)"; }
        publish-body := TextEdit { height: 74px; placeholder-text: "Message"; wrap: word-wrap; }
        HorizontalBox {
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Send";
                enabled: publish-body.text != "";
                clicked => {
                    root.publish(publish-title.text, publish-body.text);
                    publish-body.text = "";
                }
            }
        }

        Rectangle { height: 1px; background: #d8d8d8; }

        HorizontalBox {
            Text { text: "Recent notifications"; font-size: 18px; font-weight: 600; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.status-text; color: root.connected ? #167a36 : #666; }
        }

        ListView {
            vertical-stretch: 1;
            for item in root.notifications: Rectangle {
                height: content.preferred-height + 18px;
                background: #f6f6f6;
                border-color: #dedede;
                border-width: 1px;
                border-radius: 5px;
                content := VerticalBox {
                    x: 9px;
                    y: 7px;
                    width: parent.width - 18px;
                    spacing: 3px;
                    HorizontalBox {
                        Text { text: item.title; font-weight: 650; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: item.topic + " · " + item.time; color: #777; }
                    }
                    Text { text: item.message; wrap: word-wrap; }
                }
            }
        }

        HorizontalBox {
            Text { text: "Closing hides the window; the client keeps running in the taskbar notification area."; color: #777; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Quit"; clicked => { root.quit(); } }
        }
    }
}

export component NotificationPopup inherits Window {
    title: "ntfy notification";
    icon: @image-url("assets/icon.png");
    no-frame: true;
    always-on-top: true;
    preferred-width: 380px;
    preferred-height: 132px;
    min-width: 380px;
    min-height: 132px;
    background: #202124;

    in-out property <string> notification-title;
    in-out property <string> notification-message;
    in-out property <string> notification-topic;
    callback dismiss;

    Rectangle {
        background: #202124;
        border-color: #55585c;
        border-width: 1px;
        border-radius: 10px;
        clip: true;

        VerticalBox {
            padding-left: 16px;
            padding-right: 42px;
            padding-top: 13px;
            padding-bottom: 12px;
            spacing: 6px;
            Text {
                text: root.notification-title;
                color: white;
                font-size: 17px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.notification-message;
                color: #e5e5e5;
                wrap: word-wrap;
                max-height: 58px;
                overflow: elide;
            }
            Text {
                text: root.notification-topic;
                color: #aeb4bb;
                font-size: 11px;
                overflow: elide;
            }
        }

        Rectangle {
            x: parent.width - 38px;
            y: 7px;
            width: 30px;
            height: 30px;
            border-radius: 15px;
            background: close-area.has-hover ? #3c4043 : transparent;
            Text {
                text: "×";
                color: #d8d8d8;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            close-area := TouchArea { clicked => { root.dismiss(); } }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("assets/icon.png");
    tooltip: "ntfy for Windows · running in background";
    title: "ntfy";
    in-out property <bool> tray-visible <=> root.visible;
    callback show-window;
    callback quit;

    clicked => { root.show-window(); }

    Menu {
        MenuItem { title: "Show ntfy"; activated => { root.show-window(); } }
        MenuSeparator {}
        MenuItem { title: "Quit"; activated => { root.quit(); } }
    }
}
