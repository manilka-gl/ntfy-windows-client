import {
    CheckBox,
    HorizontalBox,
    LineEdit,
    VerticalBox,
} from "std-widgets.slint";
import {
    CompactButton,
    FieldLabel,
    PageHint,
    PageTitle,
    Theme,
} from "components_v2.slint";

export component ConnectionPage inherits Rectangle {
    in-out property <string> server-url;
    in-out property <string> topic;
    in-out property <string> token;
    in-out property <bool> auto-connect;
    in property <bool> connected;
    callback toggle-subscription();
    callback save-settings();

    background: #00000000;

    PageTitle {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: "Connection";
    }

    PageHint {
        x: 0px;
        y: 29px;
        width: parent.width;
        text: "One native streaming channel. Credentials remain local and the token stays in memory.";
    }

    Rectangle {
        x: parent.width > 1040px ? (parent.width - 1040px) / 2 : 0px;
        y: 54px;
        width: parent.width > 1040px ? 1040px : parent.width;
        height: parent.height > 430px ? 376px : parent.height - 54px;
        border-radius: 12px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 3px;
            height: parent.height;
            background: root.connected ? Theme.accent : Theme.cyan;
        }

        VerticalBox {
            x: 18px;
            y: 14px;
            width: parent.width - 36px;
            height: parent.height - 28px;
            spacing: 6px;

            FieldLabel { text: "SERVER ENDPOINT"; }
            LineEdit {
                height: 34px;
                text <=> root.server-url;
                placeholder-text: "https://ntfy.sh";
            }

            HorizontalBox {
                height: 62px;
                spacing: 10px;

                VerticalBox {
                    spacing: 4px;
                    FieldLabel { text: "TOPIC"; }
                    LineEdit {
                        height: 34px;
                        text <=> root.topic;
                        placeholder-text: "alerts";
                    }
                }

                VerticalBox {
                    spacing: 4px;
                    FieldLabel { text: "ACCESS TOKEN"; }
                    LineEdit {
                        height: 34px;
                        text <=> root.token;
                        input-type: password;
                        placeholder-text: "Optional · never persisted";
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            HorizontalBox {
                height: 34px;
                spacing: 8px;

                CheckBox {
                    text: "Connect automatically";
                    checked <=> root.auto-connect;
                }
                Rectangle { horizontal-stretch: 1; }
                CompactButton {
                    width: 74px;
                    label: "Save";
                    clicked => { root.save-settings(); }
                }
                CompactButton {
                    width: 104px;
                    primary: true;
                    label: root.connected ? "Disconnect" : "Subscribe";
                    clicked => { root.toggle-subscription(); }
                }
            }

            Rectangle { vertical-stretch: 1; }

            Rectangle {
                height: 52px;
                border-radius: 9px;
                background: Theme.chrome;
                border-width: 1px;
                border-color: root.connected ? #477766 : Theme.border;

                Rectangle {
                    x: 12px;
                    y: 14px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.connected ? Theme.accent : Theme.muted;
                }

                Text {
                    x: 28px;
                    y: 7px;
                    width: parent.width - 40px;
                    height: 18px;
                    text: root.connected ? "Listener active" : "Listener ready";
                    color: Theme.text;
                    font-size: 11px;
                    font-weight: 680;
                    vertical-alignment: center;
                }

                Text {
                    x: 28px;
                    y: 25px;
                    width: parent.width - 40px;
                    height: 18px;
                    text: root.connected
                        ? "Closing this window releases the interface while the tray listener continues."
                        : "Open the tray icon at any time to restore the interface.";
                    color: Theme.muted;
                    font-size: 9px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
