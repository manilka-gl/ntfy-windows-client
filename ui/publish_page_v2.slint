import {
    HorizontalBox,
    LineEdit,
    TextEdit,
    VerticalBox,
} from "std-widgets.slint";
import {
    CompactButton,
    FieldLabel,
    PageHint,
    PageTitle,
    Theme,
} from "components_v2.slint";

export component PublishPage inherits Rectangle {
    in property <string> topic;
    callback publish(string, string);

    background: #00000000;

    PageTitle {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: "Publish";
    }

    PageHint {
        x: 0px;
        y: 29px;
        width: parent.width;
        text: "Compose and send directly through native WinHTTP without opening a browser.";
    }

    Rectangle {
        x: 0px;
        y: 54px;
        width: parent.width;
        height: parent.height - 54px;
        border-radius: 12px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 3px;
            height: parent.height;
            background: Theme.cyan;
        }

        VerticalBox {
            x: 18px;
            y: 14px;
            width: parent.width - 36px;
            height: parent.height - 28px;
            spacing: 6px;

            FieldLabel { text: "TITLE · OPTIONAL"; }
            publish-title := LineEdit {
                height: 34px;
                placeholder-text: "A concise notification title";
            }

            FieldLabel { text: "MESSAGE"; }
            publish-body := TextEdit {
                vertical-stretch: 1;
                min-height: 96px;
                placeholder-text: "Type the notification body";
                wrap: word-wrap;
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            HorizontalBox {
                height: 34px;
                spacing: 8px;

                Rectangle {
                    width: 8px;
                    height: 34px;
                    background: #00000000;

                    Rectangle {
                        x: 0px;
                        y: 13px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.topic == "" ? Theme.danger : Theme.accent;
                    }
                }

                Text {
                    text: root.topic == ""
                        ? "Select a topic on the Connection page"
                        : "Destination  //  " + root.topic;
                    color: root.topic == "" ? Theme.danger : Theme.muted;
                    font-size: 9px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    width: 86px;
                    text: publish-body.text == "" ? "Awaiting message" : "Ready to send";
                    color: Theme.muted;
                    font-size: 9px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                CompactButton {
                    width: 76px;
                    primary: true;
                    label: "Send";
                    enabled: publish-body.text != "" && root.topic != "";
                    clicked => {
                        root.publish(publish-title.text, publish-body.text);
                        publish-title.text = "";
                        publish-body.text = "";
                    }
                }
            }
        }
    }
}
