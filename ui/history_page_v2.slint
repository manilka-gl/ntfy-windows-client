import { Button, ListView } from "std-widgets.slint";
import { MessageRow, NotificationItem, Theme } from "components_v2.slint";

export component HistoryPage inherits Rectangle {
    in property <[NotificationItem]> notifications;
    callback clear-notifications();

    background: #00000000;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width - 118px;
        height: 30px;
        text: "Recent notifications";
        color: Theme.text;
        font-size: 23px;
        font-weight: 700;
        vertical-alignment: center;
    }

    Text {
        x: 0px;
        y: 34px;
        width: parent.width - 118px;
        height: 20px;
        text: "Stores up to 32 messages with 1 KiB retained per body.";
        color: Theme.secondary;
        font-size: 12px;
        vertical-alignment: center;
    }

    Button {
        x: parent.width - 96px;
        y: 2px;
        width: 96px;
        height: 30px;
        text: "Clear";
        enabled: root.notifications.length > 0;
        clicked => { root.clear-notifications(); }
    }

    if root.notifications.length == 0: Rectangle {
        x: 0px;
        y: 70px;
        width: parent.width;
        height: parent.height - 70px;
        border-radius: 12px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;

        Text {
            x: 24px;
            y: parent.height / 2 - 24px;
            width: parent.width - 48px;
            height: 24px;
            text: "No notifications yet";
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            x: 24px;
            y: parent.height / 2 + 6px;
            width: parent.width - 48px;
            height: 22px;
            text: "Messages received while the window is closed appear here when it is reopened.";
            color: Theme.muted;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.notifications.length > 0: history-list := ListView {
        x: 0px;
        y: 70px;
        width: parent.width;
        height: parent.height - 70px;

        for item in root.notifications: MessageRow {
            item: item;
            width: history-list.width - 10px;
        }
    }
}
