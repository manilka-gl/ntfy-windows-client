import { Button, ListView } from "std-widgets.slint";
import { MessageRow, NotificationItem, Theme } from "components_v2.slint";

export component HistoryPage inherits Rectangle {
    in property <[NotificationItem]> notifications;
    callback clear-notifications();

    background: #00000000;

    Text {
        width: parent.width - 110px;
        height: 30px;
        text: "Recent notifications";
        color: Theme.text;
        font-size: 23px;
        font-weight: 700;
    }

    Text {
        y: 32px;
        width: parent.width - 110px;
        height: 20px;
        text: "Bounded to 32 messages and 1 KiB per body.";
        color: Theme.secondary;
        font-size: 12px;
    }

    Button {
        x: parent.width - 90px;
        y: 4px;
        width: 90px;
        text: "Clear";
        clicked => { root.clear-notifications(); }
    }

    if root.notifications.length == 0: Rectangle {
        y: 68px;
        width: parent.width;
        height: parent.height - 68px;
        border-radius: 12px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;

        Text {
            x: 24px;
            y: parent.height / 2 - 20px;
            width: parent.width - 48px;
            height: 24px;
            text: "No notifications yet";
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            x: 24px;
            y: parent.height / 2 + 8px;
            width: parent.width - 48px;
            height: 20px;
            text: "Background messages appear here when the window is reopened.";
            color: Theme.muted;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }

    if root.notifications.length > 0: history-list := ListView {
        y: 68px;
        width: parent.width;
        height: parent.height - 68px;

        for item in root.notifications: MessageRow {
            item: item;
            width: history-list.width - 10px;
        }
    }
}
