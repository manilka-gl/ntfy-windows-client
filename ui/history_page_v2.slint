import { ListView } from "std-widgets.slint";
import {
    CompactButton,
    MessageRow,
    NotificationItem,
    PageHint,
    PageTitle,
    Theme,
} from "components_v2.slint";

export component HistoryPage inherits Rectangle {
    in property <[NotificationItem]> notifications;
    callback clear-notifications();

    background: #00000000;

    PageTitle {
        x: 0px;
        y: 0px;
        width: parent.width - 108px;
        text: "History";
    }

    PageHint {
        x: 0px;
        y: 29px;
        width: parent.width - 108px;
        text: root.notifications.length + " retained · maximum 32 messages · 1 KiB per body";
    }

    CompactButton {
        x: parent.width - 92px;
        y: 3px;
        width: 92px;
        label: "Clear all";
        enabled: root.notifications.length > 0;
        clicked => { root.clear-notifications(); }
    }

    if root.notifications.length == 0: Rectangle {
        x: 0px;
        y: 54px;
        width: parent.width;
        height: parent.height - 54px;
        border-radius: 12px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;

        Rectangle {
            x: parent.width / 2 - 23px;
            y: parent.height / 2 - 54px;
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background: #0c1721;
            border-width: 1px;
            border-color: Theme.border;

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: "//";
                color: Theme.cyan;
                font-size: 16px;
                font-weight: 760;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 24px;
            y: parent.height / 2 + 2px;
            width: parent.width - 48px;
            height: 22px;
            text: "No notifications captured";
            color: Theme.text;
            font-size: 14px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            x: 24px;
            y: parent.height / 2 + 27px;
            width: parent.width - 48px;
            height: 18px;
            text: "Background messages appear here when the interface is restored.";
            color: Theme.muted;
            font-size: 9px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if root.notifications.length > 0: history-list := ListView {
        x: 0px;
        y: 54px;
        width: parent.width;
        height: parent.height - 54px;

        for item in root.notifications: MessageRow {
            item: item;
            width: history-list.width - 10px;
        }
    }
}
