import { Button, HorizontalBox } from "std-widgets.slint";
import { NotificationItem, Tab, Theme } from "components_v2.slint";
import { ConnectionPage } from "connection_page_v2.slint";
import { NotificationSettingsPage } from "notification_page_v2.slint";
import { PublishPage } from "publish_page_v2.slint";
import { HistoryPage } from "history_page_v2.slint";

export { NotificationItem } from "components_v2.slint";
export { NotificationPopup } from "popup_v2.slint";

export component AppWindow inherits Window {
    title: "ntfy for Windows";
    icon: @image-url("assets/icon.svg");
    preferred-width: 860px;
    preferred-height: 600px;
    min-width: 720px;
    min-height: 540px;
    background: Theme.bg;

    in-out property <string> server-url: "https://ntfy.sh";
    in-out property <string> topic: "";
    in-out property <string> token: "";
    in-out property <bool> notifications-enabled: true;
    in-out property <bool> sound-enabled: true;
    in-out property <bool> auto-connect: true;
    in-out property <int> placement-index: 2;
    in-out property <int> audio-output-index: 0;
    in-out property <bool> connected: false;
    in-out property <string> status-text: "Ready";
    in property <[string]> audio-outputs;
    in property <[NotificationItem]> notifications;
    property <int> page: 0;

    callback toggle-subscription();
    callback publish(string, string);
    callback save-settings();
    callback clear-notifications();
    callback refresh-audio-outputs();
    callback quit();

    Rectangle {
        width: parent.width;
        height: 60px;
        background: Theme.chrome;

        Text {
            x: 20px;
            y: 10px;
            width: 58px;
            height: 32px;
            text: "ntfy";
            color: Theme.accent;
            font-size: 25px;
            font-weight: 800;
        }

        Text {
            x: 82px;
            y: 12px;
            width: parent.width - 300px;
            height: 20px;
            text: "Windows notification listener";
            color: Theme.text;
            font-size: 13px;
            font-weight: 650;
        }

        Text {
            x: 82px;
            y: 32px;
            width: parent.width - 300px;
            height: 16px;
            text: "Native networking · UI released when closed";
            color: Theme.muted;
            font-size: 10px;
        }

        Rectangle {
            x: parent.width - 148px;
            y: 15px;
            width: 126px;
            height: 30px;
            border-radius: 15px;
            background: root.connected ? Theme.accent-soft : #202a37;
            border-width: 1px;
            border-color: root.connected ? #286044 : Theme.border;

            Rectangle {
                x: 13px;
                y: 10px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.connected ? Theme.accent : Theme.muted;
            }

            Text {
                x: 29px;
                width: 82px;
                height: parent.height;
                text: root.connected ? "Listening" : "Offline";
                color: root.connected ? #a7f3c0 : Theme.secondary;
                font-size: 11px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }
    }

    Rectangle {
        x: 0px;
        y: 60px;
        width: parent.width;
        height: 52px;
        background: Theme.chrome;

        HorizontalBox {
            x: 18px;
            y: 8px;
            width: parent.width - 36px;
            height: 36px;
            spacing: 8px;

            Tab {
                horizontal-stretch: 1;
                label: "Connection";
                selected: root.page == 0;
                activated => { root.page = 0; }
            }
            Tab {
                horizontal-stretch: 1;
                label: "Notifications";
                selected: root.page == 1;
                activated => { root.page = 1; }
            }
            Tab {
                horizontal-stretch: 1;
                label: "Publish";
                selected: root.page == 2;
                activated => { root.page = 2; }
            }
            Tab {
                horizontal-stretch: 1;
                label: "History (" + root.notifications.length + ")";
                selected: root.page == 3;
                activated => { root.page = 3; }
            }
        }

        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }
    }

    Rectangle {
        x: 26px;
        y: 132px;
        width: parent.width - 52px;
        height: parent.height - 184px;
        background: #00000000;

        if root.page == 0: ConnectionPage {
            width: parent.width;
            height: parent.height;
            server-url <=> root.server-url;
            topic <=> root.topic;
            token <=> root.token;
            auto-connect <=> root.auto-connect;
            connected: root.connected;
            save-settings => { root.save-settings(); }
            toggle-subscription => { root.toggle-subscription(); }
        }

        if root.page == 1: NotificationSettingsPage {
            width: parent.width;
            height: parent.height;
            notifications-enabled <=> root.notifications-enabled;
            sound-enabled <=> root.sound-enabled;
            placement-index <=> root.placement-index;
            audio-output-index <=> root.audio-output-index;
            audio-outputs: root.audio-outputs;
            save-settings => { root.save-settings(); }
            refresh-audio-outputs => { root.refresh-audio-outputs(); }
        }

        if root.page == 2: PublishPage {
            width: parent.width;
            height: parent.height;
            topic: root.topic;
            publish(title, body) => { root.publish(title, body); }
        }

        if root.page == 3: HistoryPage {
            width: parent.width;
            height: parent.height;
            notifications: root.notifications;
            clear-notifications => { root.clear-notifications(); }
        }
    }

    Rectangle {
        x: 0px;
        y: parent.height - 32px;
        width: parent.width;
        height: 32px;
        background: Theme.chrome;

        Rectangle {
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }

        Text {
            x: 14px;
            width: parent.width - 108px;
            height: parent.height;
            text: root.status-text;
            color: Theme.muted;
            font-size: 10px;
            overflow: elide;
            vertical-alignment: center;
        }

        Button {
            x: parent.width - 76px;
            y: 4px;
            width: 64px;
            height: 24px;
            text: "Quit";
            clicked => { root.quit(); }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("assets/icon.svg");
    in-out property <bool> tray-visible <=> root.visible;
    in-out property <bool> connected: false;
    tooltip: root.connected ? "ntfy · listening" : "ntfy · offline";
    title: "ntfy";
    callback show-window();
    callback toggle-subscription();
    callback quit();

    clicked => { root.show-window(); }

    Menu {
        MenuItem {
            title: "Open ntfy";
            activated => { root.show-window(); }
        }
        MenuItem {
            title: root.connected ? "Disconnect" : "Subscribe";
            activated => { root.toggle-subscription(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}
